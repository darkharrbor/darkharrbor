# DarkHarrbor legacy standalone-binary environment reference.
# Canonical Compose does not copy or mount this file and references none of its
# values. Compose users run `docker compose run --rm -it darkharrbor setup`, then
# start the daemon.
# This file is not sufficient by itself: normal startup also requires the sealed
# store created at wizard stage S7. Direct-binary operators may intentionally
# copy this file to a working-directory `.env`; the resulting file is gitignored.

# ── Legacy plaintext inputs (standalone binary only) ────────────────────────

# Optional TorBox API token (from https://torbox.app/settings). Leave empty to
# use another debrid or NNTP lane; setup accepts Enter-to-skip at S2.
HARRBOR_TORBOX_API_TOKEN=

# Optional TorBox endpoint overrides
# HARRBOR_TORBOX_BASE_URL=https://api.torbox.app/v1
# HARRBOR_TORBOX_SEARCH_BASE_URL=https://search-api.torbox.app
# TorBox usenet capability override: auto (follow plan), on (force enable), off (force disable)
# HARRBOR_TORBOX_USENET=auto

# Internal compatibility credentials. The setup wizard normally generates and
# seals both; direct-binary deployments must supply them through a supported
# configuration source.
# Password for the fake qBittorrent WebUI (Sonarr/Radarr use this to connect)
HARRBOR_QBIT_PASSWORD=

# API key for the fake SABnzbd interface (Sonarr/Radarr usenet client)
HARRBOR_SAB_API_KEY=

# ── Sealed provider secrets (recommended for at-rest protection) ────────────
# Instead of leaving the provider credentials in plaintext above, you can seal
# them into an encrypted store (argon2id key derivation + AES-256-GCM) and load
# them at startup. Sealed values take precedence over any plaintext env value.
#
# The sealable provider keys are:
#   HARRBOR_TORBOX_API_TOKEN, HARRBOR_QBIT_PASSWORD, HARRBOR_SAB_API_KEY,
#   HARRBOR_STREAM_SECRET, HARRBOR_MEDIAFLOW_PASSWORD,
#   HARRBOR_NNTP_USERNAME, HARRBOR_NNTP_PASSWORD
#
# Create the store (you are prompted with / shown a generated password):
#   darkharrbor seal --file /config/secrets.sealed   # provide KEY=VALUE lines on stdin
#
# Then point Dark Harrbor at it. Unlock modes: env | keyfile | prompt.
#   - keyfile: store the generated password in a 0600 file, reference it here
#   - env:     supply the password via HARRBOR_SECRETS_PASSWORD
#   - prompt:  read the password interactively at startup
# HARRBOR_SECRETS_FILE=/config/secrets.sealed
# HARRBOR_SECRETS_UNLOCK=keyfile
# HARRBOR_SECRETS_KEY_FILE=/config/secrets.key

# ── Acquisition preference (the one knob that matters) ──────────────────────
# Ordered, comma-separated list of acquisition LANES.
#   position = priority (earlier preferred)   presence = enabled (omit = off)
# Lanes:
#   torbox_torrent    TorBox CACHED torrent  (CDN)
#   torbox_nzb        TorBox CACHED nzb      (CDN)
#   nntp_nzb          NZB over NNTP          (usenet floor — serves any NZB)
#   uncached_torrent         TorBox UNCACHED torrent add (governor-gated)
#   uncached_torrent_derank  Same path with authoritative misses deranked in Arr
# The two uncached lanes are mutually exclusive.
#
# Default (classic behavior) if unset: torbox_torrent,nntp_nzb
# Recommended cached-first full stack:
# HARRBOR_PREFERENCE=torbox_torrent,torbox_nzb,nntp_nzb,uncached_torrent_derank
#
# Examples:
#   Cached torrents only, no usenet:     torbox_torrent
#   Usenet only, NNTP:                   nntp_nzb
#   TorBox-cached NZBs only (no NNTP):   torbox_nzb        (cache-checks at search)
#   Everything, cached preferred:        torbox_torrent,torbox_nzb,nntp_nzb,uncached_torrent
# HARRBOR_PREFERENCE=torbox_torrent,nntp_nzb

# ── Selection mode: cache-aware meta-indexer over Prowlarr (optional) ────────
# Leave BOTH unset for fulfillment-only mode (cached/uncached decided after the
# grab at the qBit/SAB shim — no Prowlarr wiring needed).
#
# Set both to make Dark Harrbor sit ABOVE Prowlarr: it fans each Sonarr/Radarr
# search to YOUR Prowlarr indexers and returns only releases eligible under
# HARRBOR_PREFERENCE, so the arr can't grab something with no lane to fulfill.
# Add Dark Harrbor's /torznab as an indexer in Prowlarr; its own indexer is
# auto-excluded from the fan-out by matching HARRBOR_SERVER_BASE_URL.
# HARRBOR_PROWLARR_BASE_URL=http://prowlarr:9696
# HARRBOR_PROWLARR_API_KEY=
# Optional: restrict the fan-out to specific Prowlarr indexer IDs (else all
# enabled indexers except Dark Harrbor's own).
# HARRBOR_PROWLARR_INDEXER_IDS=

# ── Optional overrides (defaults shown) ─────────────────────────────────────

# Base URL used for .strm generation AND the selection-mode loop-safety
# self-match (must match the base URL Dark Harrbor is registered under in Prowlarr).
# HARRBOR_SERVER_BASE_URL=http://localhost:8381
# Canonical Compose overrides this to http://darkharrbor:8381 and sets :8381
# only inside its unpublished arr-net network; do not publish that port without
# a restricted TLS proxy.
# HARRBOR_SERVER_ADDRESS=127.0.0.1:8381

# Optional MediaFlow-compatible playback proxy. Leave the password unset to
# keep all three compatibility endpoints fail-closed. Public IP is needed only
# when the aggregator cannot infer that the configured proxy address is private.
# HARRBOR_MEDIAFLOW_PASSWORD=
# Exact client-facing HTTP(S) origin for generated playback URLs; no path,
# query, fragment, or credentials. Compose deployments put this non-secret
# installation-specific value in /config/darkharrbor.conf.
# HARRBOR_MEDIAFLOW_BASE_URL=
# HARRBOR_MEDIAFLOW_PUBLIC_IP=
# For an AIOStreams backend whose client-facing origin differs from its
# arr-net URL, set the exact public origin (no path, query, or credentials).
# HARRBOR_HTTPBACKEND_AIOSTREAMS_PUBLIC_URL=
# Proof-gated durable aggregator-route admission is explicit and defaults off.
# HARRBOR_NNTP_CROSSLANE_SPLICE=false

# Log verbosity: INFO or DEBUG
# HARRBOR_LOG_LEVEL=INFO

# SQLite database path inside the container
# HARRBOR_DATABASE_PATH=/config/darkharrbor.db

# Data root inside the container (strm/ and sidecar/ live here)
# HARRBOR_DATA_ROOT=/data

# Max uncached TorBox transfers in the rolling 15-day window.
# TorBox Pro — 20 is conservative. Raise after confirming no abuse warnings.
# HARRBOR_GOVERNOR_UNCACHED_BUDGET=20

# ── Legacy / derived (prefer HARRBOR_PREFERENCE above) ──────────────────────
# These still work but are DERIVED from HARRBOR_PREFERENCE when it is set, and
# only used to SYNTHESIZE a preference when it is not.
#   HARRBOR_REQUIRE_CACHED=true   <=> uncached_torrent absent from preference
#   HARRBOR_NZB_CACHE=false       <=> torbox_nzb present in preference
# HARRBOR_REQUIRE_CACHED=true
# HARRBOR_NZB_CACHE=false

# ── .strm-mode installer (REDESIGN S10, all 6 gates closed 2026-07-01) ──────
# Startup reconcile + live Docker-events watch that keeps the ffprobe relay
# shim (strm-mode/ffprobe-wrapper.sh) installed in every discovered arr
# container automatically, instead of the manual/interim compose-bind-mount
# + custom-cont-init.d setup. Off by default. Requires:
#   1. HARRBOR_STRM_INSTALLER_ENABLED=true below, AND
#   2. the docker-proxy service actually running -- it is gated behind the
#      "strm" Compose profile. Before first setup, start only that dependency:
#      `docker compose --profile strm up -d docker-proxy`. After S7 seals the
#      credentials, starting the full profile is safe.
# docker-proxy grants DH scoped Docker Engine API access (list + exec on arr
# containers only -- every other verb 403s at the proxy). VFS-only / hardened
# deployments should leave both of these off; DH then has zero Docker access.
# HARRBOR_STRM_INSTALLER_ENABLED=false
# HARRBOR_DOCKER_PROXY_URL=http://docker-proxy:2375
