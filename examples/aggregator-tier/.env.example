# Example aggregator-tier credentials. Copy to .env and fill in.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is git-ignored. NOTHING in this file belongs in docker-compose.yml --
# a credential committed to version control cannot be removed later, only
# rotated.

# --- Compose scope ----------------------------------------------------------

# Images default to the immutable references in compatibility.lock. Do not set
# AIOSTREAMS_IMAGE or STREMTHRU_IMAGE for an ordinary install. Candidate digest
# overrides are accepted only for the disposable compatibility gate documented
# in docs/AGGREGATOR-INTEGRATION.md.

# Existing installations use arr-net. A same-daemon isolated acceptance fixture
# sets this to its unique external network; no YAML edit or fixed container name
# is required.
AGGREGATOR_NETWORK=arr-net

# --- AIOStreams -------------------------------------------------------------

# Client-facing base URL. Must be reachable from EVERY VIEWING DEVICE, not just
# from the host. An address that is correct from the server and wrong from a
# phone fails opaquely at the player, naming nothing.
AIOSTREAMS_BASE_URL=http://192.0.2.10:8500

# Host bind for the published port. Use a specific interface rather than
# 0.0.0.0 if you do not want this reachable from your whole LAN.
AIOSTREAMS_BIND=192.0.2.10:8500

# Long random string. Encrypts the saved user configuration.
AIOSTREAMS_SECRET_KEY=

# Shared secret between the aggregator and DarkHarrbor. When aggregator
# integration is selected (t2/t3), `darkharrbor setup` generates this value at
# S6, seals it at S7, and prints it EXACTLY ONCE. Copy that printed literal
# here. The key is rejected from darkharrbor.conf. If either half is missing or
# mismatched, DarkHarrbor's MediaFlow surface stays disabled and reactive commit
# can never fire.
FORCE_PROXY_CREDENTIALS=

# --- StremThru --------------------------------------------------------------

# user:password. Gates the dashboard AND is the auth token the aggregator sends
# for the shared tier's usenet service.
STREMTHRU_AUTH=admin:

# Required for usenet. ONE-WAY: this encrypts the NNTP credentials stored in the
# dashboard, and losing it makes every one of them unreadable and re-entry the
# only recovery. Back it up wherever you keep the DarkHarrbor seal password.
STREMTHRU_VAULT_SECRET=

# Host bind for the published port.
STREMTHRU_BIND=192.0.2.10:8600

# --- Notes ------------------------------------------------------------------
#
# Debrid and indexer credentials are NOT here. Those live in the aggregator's
# own saved configuration, which is encrypted at rest and not environment-
# lockable -- see docs/CONFIGURATION-INVENTORY.md section 4. An installer can
# set them once but cannot keep them set, which is why they are configured
# through the aggregator rather than through this file.
#
# Usenet PROVIDERS are configured in the StremThru dashboard, not here and not
# in compose. Usenet INDEXERS are configured in AIOStreams, one addon per
# indexer. Do not configure indexers in StremThru -- that is for standalone use.
